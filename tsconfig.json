{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["node", "@webgpu/types"],
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["lib", "server", "web", "tools/*.mjs"],
  "exclude": ["web/service-worker.js"]
}
