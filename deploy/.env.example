# Copy to .env at the repository root. No account secrets go in this file.
# Loopback is suitable behind an HTTPS reverse proxy. Use the server's LAN IP
# to expose directly to your trusted LAN; plain HTTP exposes the access key.
BIND_ADDRESS=127.0.0.1
CONTROLLER_ID=2479
# Keep false until supervised physical validation.
ALLOW_LIVE_CONTROL=false
# Weather from Home Assistant (Tempest). Use an address the Docker server can
# reach. `python3 tools/configure-secrets.py --ha-token` saves the access token
# and fills in the entities below from what Home Assistant reports.
HA_URL=
HA_RAIN_RATE_ENTITY=
HA_RAIN_TOTAL_ENTITY=
HA_FORECAST_ENTITY=
